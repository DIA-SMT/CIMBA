# ── Base de datos: Supabase Cloud (sin Docker) ──
# Project Settings → Database → Connection string (URI, transaction pooler puerto 6543
# o session pooler 5432). Escapar caracteres raros de la contraseña.
DATABASE_URL=
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT propio de CIMBA (cualquier secreto de 32+ caracteres)
CIMBA_JWT_SECRET=

# ── SSO institucional Ciudad Digital ──
# Base del backend municipal para validar tokens (?auth=) contra /usuarios/authStatus.
# El JWT_SECRET_KEY municipal NO va acá ni a Vercel: validamos por API, no por firma.
CIMBA_API_CIUDAD_DIGITAL=
# Modo desarrollo sin backend municipal: habilita /dev/sso para impersonar roles.
DEV_FAKE_SSO=1

# ── Atención Ciudadana ──
CIMBA_API_ATENCION_CIUDADANA=
# Adaptador de ingesta: mock | atencion-ciudadana
CIMBA_FUENTE_AC=mock

# ── Cron (Vercel) ──
CRON_SECRET=cambiar-en-produccion

# ── Mapa ──
# Estilo del mapa base (MapLibre). Por defecto usa CARTO (gratis, con atribución).
# Para producción con SLA: MapTiler (https://maptiler.com) u hosting propio de teselas.
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
