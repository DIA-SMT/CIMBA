# ── Base de datos: Supabase Cloud (sin Docker) ──
# Project Settings → Database → Connection string (URI, transaction pooler puerto 6543
# o session pooler 5432). Escapar caracteres raros de la contraseña.
DATABASE_URL=
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT propio de CIMBA (cualquier secreto de 32+ caracteres)
CIMBA_JWT_SECRET=

# ── SSO institucional Ciudad Digital ──
# Base del backend municipal para validar tokens (?auth=) contra /usuarios/authStatus.
# El JWT_SECRET_KEY municipal NO va acá ni a Vercel: validamos por API, no por firma.
CIMBA_API_CIUDAD_DIGITAL=
# Modo desarrollo sin backend municipal: habilita el selector de rol en /acceso.
DEV_FAKE_SSO=1
# En hosting público (Vercel) el selector exige este código de acceso del equipo.
# Sin código configurado, el selector NO funciona en Vercel (solo local).
DEV_SSO_CODIGO=

# ── Atención Ciudadana (CIDITUC) ──
# API de reclamos. Sin autenticación (verificado 31/08/2026).
CIMBA_API_ATENCION_CIUDADANA=https://estadisticas.smt.gob.ar:8084
# Adaptador de ingesta: atencion-ciudadana (real) | mock (datos inventados, solo
# para desarrollo). VACÍO = el cron no ingesta nada, que es lo correcto si la
# fuente no está disponible: nunca se fabrican datos por defecto.
CIMBA_FUENTE_AC=atencion-ciudadana
# La API no lista por fecha ni pagina: la sincronización barre ids secuenciales
# desde el último importado. Estos dos acotan ese barrido.
CIMBA_AC_LOTE=200
CIMBA_AC_DESDE_ID=116000

# ── Cron (Vercel) ──
CRON_SECRET=cambiar-en-produccion

# Acceso del Director de Bacheo (rol planificación: emite órdenes, asigna
# circuitos, genera claves de empresas)
BACHEO_USUARIO=bacheo
BACHEO_PASSWORD=

# ── Avisos por email (Resend) ──
# Sin la key, los avisos por email se saltean (el push sigue andando).
# El remitente de prueba de Resend sirve hasta verificar un dominio propio.
RESEND_API_KEY=
RESEND_FROM=CIMBA <onboarding@resend.dev>
CIMBA_URL_PUBLICA=https://cimba-smt.vercel.app

# ── IA (cruce de datos vía OpenRouter) ──
# La key es server-only: jamás llega al cliente ni al repo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── Mapa ──
# Estilo del mapa base (MapLibre). Por defecto usa CARTO (gratis, con atribución).
# Para producción con SLA: MapTiler (https://maptiler.com) u hosting propio de teselas.
NEXT_PUBLIC_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_MAP_STYLE_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# ── SIGOV Obras Viales ───────────────────────────────────────────────────────
# MySQL de la Dirección, IP privada: solo se alcanza desde adentro de la red
# municipal. Lo usa el enlace (pnpm runner), no la app en Vercel.
# El usuario tiene que ser de solo lectura: CIMBA no escribe en SIGOV.
MYSQL_BACHEO_HOST=172.16.8.214
MYSQL_BACHEO_PORT=3306
MYSQL_BACHEO_USER=
MYSQL_BACHEO_PASSWORD=
MYSQL_SIGOV_DB=smt_obrasviales

# Cada cuántos minutos sincroniza el enlace cada fuente (opcional).
CIMBA_RUNNER_MIN_EMPRESAS=15
CIMBA_RUNNER_MIN_SIGOV=20
